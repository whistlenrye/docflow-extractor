# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000
EXTRACT_API_KEY=
RATE_LIMIT_PER_MIN=30
# Target web form Playwright fills. Default points at the bundled sample form.
FORM_TARGET_URL=http://localhost:3000/sample-form
# Where Playwright stores browser binaries (Render sets this in render.yaml).
PLAYWRIGHT_BROWSERS_PATH=

# Set to 0 to refuse localhost form targets (recommended off-machine).
ALLOW_LOCAL_FORM_TARGETS=1
